# Side Toolbar: Fiji's toolbar as a vertical, freely editable bar along the side of the screen
Plugins>Side Toolbar, "Start Side Toolbar", sidetoolbar.Side_Toolbar("start")
Plugins>Side Toolbar, "Add Buttons to Side Toolbar...", sidetoolbar.Side_Toolbar("add")
Plugins>Side Toolbar, "Side Toolbar Settings...", sidetoolbar.Side_Toolbar("settings")
Plugins>Side Toolbar, "Undo Side Toolbar Change", sidetoolbar.Side_Toolbar("undo")
Plugins>Side Toolbar, "-"
Plugins>Side Toolbar, "Export Side Toolbar...", sidetoolbar.Side_Toolbar("export")
Plugins>Side Toolbar, "Import Side Toolbar...", sidetoolbar.Side_Toolbar("import")
Plugins>Side Toolbar, "Reset Side Toolbar...", sidetoolbar.Side_Toolbar("reset")
Plugins>Side Toolbar, "-"
Plugins>Side Toolbar, "Show Classic Toolbar", sidetoolbar.Side_Toolbar("stop")
Plugins>Side Toolbar, "Side Toolbar Help", sidetoolbar.Side_Toolbar("help")
